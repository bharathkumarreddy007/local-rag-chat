RAG_API_KEY=GENERATED_BY_SETUP
CHAT_MODEL=qwen3:4b
EMBEDDING_MODEL=all-minilm:latest
MAX_DISTANCE=0.9
# Native Python uses the host Ollama. Compose overrides this to its internal service.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# The lab image follows Ollama updates; pin a reviewed version/digest for deployment.
OLLAMA_IMAGE=ollama/ollama:latest
